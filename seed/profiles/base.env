# 공통 노브. 프로파일 파일이 이 값을 덮어쓸 수 있다.
# 규모는 절대 숫자가 아니라 DB 컨테이너 메모리에서 역산한다.

DB_MEM_GB=2               # DB 컨테이너 메모리 한도. 규모 계산의 기준
CONTENT_BYTES=500         # posts.content 평균 길이
BYTES_PER_UNIT=2350       # posts 1개당 총 크기. 2026-09-19 M 실측값(1077MB/48만)
                          # S는 2,684로 14% 크다. 작은 테이블일수록 페이지 헤더와
                          # 덜 채워진 페이지의 상대 비용이 커서다. M·L에는 M 실측값이 맞고,
                          # S는 POSTS_OVERRIDE를 쓰므로 이 값의 영향을 받지 않는다.

# 엔티티 비율 (posts = N 기준)
BOARDS=20                 # 규모와 무관하게 고정
COMMENTS_PER_POST=3       # 핫 글에 댓글이 몰려야 상세조회 LIMIT 20이 일을 한다
REPLY_RATIO=0.2           # 전체 댓글 중 대댓글 비율. 나머지가 최상위 댓글이다
VIEWS_PER_POST=6
LIKES_PER_POST=1
POSTS_PER_USER=10         # users = N / 10. 좋아요 UNIQUE 충돌률을 결정한다

# k6 전용 사용자 풀. 시드 활동 사용자 뒤 구간에 만들고 좋아요·댓글을 붙이지 않는다.
# 이 풀이 곧 JWT sub 목록이다. 규모와 무관하게 고정.
K6_USER_POOL=10000

# Zipf 지수 s. 순위 r의 빈도가 r^-s 에 비례한다. 클수록 인기 항목에 몰린다.
ZIPF_S=1.0                # 조회·좋아요. 설계서 v3 6.1의 s=1.0 그대로
COMMENT_ZIPF_S=0.8        # 댓글은 완화한다. s=1이면 한 글에 댓글이 10만 개 붙어
                          # 그 글 하나가 상세조회 측정을 지배한다
LIKE_CANDIDATE_MULT=2     # 좋아요 후보 배수 (UNIQUE 중복 제거 손실 보전)

# event_id 네임스페이스 (16진수 앞 2자리). k6는 '1'로 시작하는 구간을 쓴다.
EVENT_NS=00
