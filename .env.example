# 로컬 전용. .gitignore 대상이라 커밋되지 않는다.
# 이 파일을 .env로 복사해서 쓴다. .env는 커밋되지 않는다.
# --- 시드 Postgres 접속 (seed/compose.seed.yml) ---
PGUSER=hjo
PGPASSWORD=hjo
PGPORT=5432

# --- 앱이 붙을 곳 ---
# 시드가 만든 작업용 DB. 프로파일을 바꿔도 이름은 bench로 고정이다.
DB_WRITE_URL=jdbc:postgresql://localhost:5432/bench
DB_USERNAME=hjo
DB_PASSWORD=hjo

# --- 인증 ---
# HS256 공유 비밀키. 32바이트 이상. 없으면 앱이 기동하지 않는다.
# k6도 같은 값으로 런타임에 토큰을 서명한다. 팀 전원이 같은 값을 써야 한다.
JWT_SECRET=<팀에서 공유받은 32바이트 이상 문자열>
